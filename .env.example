# ==============================================================================
# DhakaPath Environment Variables Template
# Copy this file to .env.local to configure custom API keys.
# NOTE: All keys are 100% OPTIONAL. The app works completely offline without them
# using deterministic local lexers, in-memory graph routing, and local storage.
# ==============================================================================

# 1. Supabase (Optional: For syncing alerts & logs to cloud Supabase)
# If omitted or left as placeholder, the app operates fully in-memory.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-dhakapath.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# 2. LLM Intent Parser (Optional: Groq / OpenRouter / Gemini free tiers)
# If omitted, DhakaPath uses its sub-millisecond deterministic phonetic Banglish lexer.
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
GEMINI_API_KEY=

# 3. Admin Console Passcode (Optional: default is "dhakapath2026")
NEXT_PUBLIC_ADMIN_PASSCODE=dhakapath2026
