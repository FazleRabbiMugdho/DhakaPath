# Copy to .env.local and fill in. Every variable is optional unless noted;
# the app runs offline (in-memory) without any of them.

# --- Admin (/admin) ----------------------------------------------------------
# Required to use admin. There is no built-in default: admin stays disabled until set.
ADMIN_PASSCODE=
# Signs session and admin cookies. Set a long random value in production so
# all server instances (and restarts) accept the same cookies.
SESSION_SECRET=

# --- Deployment --------------------------------------------------------------
# Rate limits read the client IP only from trusted headers. On Vercel this is
# automatic (VERCEL=1). Behind your own reverse proxy that overwrites
# X-Forwarded-For, set TRUST_PROXY=1. Otherwise all clients share one bucket.
TRUST_PROXY=
# Send HSTS and upgrade-insecure-requests outside Vercel. Only set this when the
# site is served over HTTPS; on plain HTTP it breaks every asset.
# Read at build time (`next build`), not at `next start`.
FORCE_HTTPS=

# --- Supabase (optional persistence) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Public, read-only after migration 0002.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by /api/sync for validated writes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI fallbacks (optional; the deterministic parser always runs first) ---------
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Signboard photo OCR
GEMINI_API_KEY=
